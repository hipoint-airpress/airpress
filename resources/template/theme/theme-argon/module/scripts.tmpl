{# 页面底部脚本：主题交互逻辑、数学公式 CDN、代码高亮主题（公式配置已移至 argontheme.js） #}
<script src="{{ theme_base }}/assets/app.js?version={{ theme.Version }}"></script>

{% if settings.math_render == "mathjax3" %}
    <script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml-full.js" id="MathJax-script" async></script>
{% elif settings.math_render == "katex" %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.11.1/dist/katex.min.css">
    <script src="https://cdn.jsdelivr.net/npm/katex@0.11.1/dist/katex.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/katex@0.11.1/dist/contrib/auto-render.min.js"></script>
{% endif %}

{% if settings.enable_code_highlight %}
    <link rel="stylesheet" href="{{ theme_base }}/assets/vendor/highlight/styles/{{ settings.code_theme|default:"vs2015" }}.css">
{% endif %}
