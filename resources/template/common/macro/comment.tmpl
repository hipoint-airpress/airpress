{% if type == "journal" or not target.DisallowComment %}
        {# 评论插件依赖全局共享的本地化副本(/vendor/,见 resources/vendor),主题无需自带。 #}
        {# halo-comment 以 webpack externals 依赖全局 Vue 2(内部调用 Vue.extend),必须先加载 vue.min.js #}
        <script src="/vendor/vue/2.6.14/vue.min.js"></script>
        <script src="/vendor/halo-comment/1.3.2/halo-comment.min.js"></script>
        <halo-comment id="{{ target.ID }}" type="{{ type }}"/>
{% endif %}
