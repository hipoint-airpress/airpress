{% if type == "journal" or not target.DisallowComment %}
        <div id="comment"></div>
        <script src="https://cdn.staticfile.org/vue/3.3.4/vue.global.prod.js"></script>
        <script src="{{ options.comment_internal_plugin_js }}"></script>
        <script>
            AirPressComment.init("#comment", {
                target: "{{ type }}s",
                targetId: {{ target.ID }},
                colorScheme: "light"
            });
        </script>
{% endif %}